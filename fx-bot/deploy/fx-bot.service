# 환율·테더 알림 봇 (상주 실행)
#
# 이 파일을 직접 복사해도 되지만, 경로·계정을 채워 넣는 설치 스크립트가 있다:
#   sudo fx-bot/deploy/install-systemd.sh
#
# 손으로 할 때는 아래 __대문자__ 자리를 채워 /etc/systemd/system/fx-bot.service
# 로 두고, 비밀값은 /etc/fx-bot.env (600, root 소유)에 적는다.

[Unit]
Description=환율·테더 차익 알림 텔레그램 봇
# 문서는 저장소 안 fx-bot/README.md. URL 을 박아두면 저장소 이름을 바꿀 때 썩는다.
# 부팅 직후엔 DNS 가 아직 안 서 있는 경우가 있다. 네트워크가 "설정 완료"될 때까지 기다린다.
After=network-online.target
Wants=network-online.target

# 설정 오류로 즉사하는 경우까지 무한 재시작하면 로그만 쌓인다. 5분에 10번 넘게
# 죽으면 멈추고 failed 로 남긴다 (systemctl status 로 보인다).
# ※ 이 두 키는 [Service] 가 아니라 [Unit] 에 있어야 한다. [Service] 에 두면
#    systemd 가 "Unknown key name" 으로 무시해 재시작 제한이 걸리지 않는다.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=/etc/fx-bot.env
ExecStart=__NODE__ __REPO__/fx-bot/index.mjs

# 죽으면 무조건 다시 띄운다. 알림 봇이 조용한 건 "기회가 없다"와 구분되지 않으므로
# 살아 있는 것 자체가 기능이다.
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fx-bot

# 봇은 저장소 디렉터리와 상태 파일 말고는 건드릴 일이 없다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__REPO__/fx-bot

[Install]
WantedBy=multi-user.target
