# /etc/fx-bot.env — 봇 비밀값 (600, root 소유)
#
# 토큰은 저장소에 두지 않는다. 실수로 커밋되는 게 가장 흔한 유출 경로다.
# 값에 따옴표를 붙이지 마세요 (systemd EnvironmentFile 은 따옴표까지 값으로 읽습니다).

# @BotFather 에서 받은 토큰
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# 알림을 받을 chat id. 쉼표로 여러 개 가능.
# 확인: curl -s "https://api.telegram.org/bot<토큰>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
TELEGRAM_CHAT_ID=123456789

# 선택 — 기본값은 fx-bot/config.json, fx-bot/state.json
# FX_BOT_CONFIG=/etc/fx-bot/config.json
# FX_BOT_STATE=/var/lib/fx-bot/state.json
